# Django ------------------------------------------------------------------------
# Settings module: config.settings.dev (default for manage.py) or config.settings.prod
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_LOG_LEVEL=INFO

# Database (PostgreSQL) ---------------------------------------------------------
DATABASE_URL=postgres://crm_user:your_password@localhost:5432/crm_db
DB_CONN_MAX_AGE=60

# CORS --------------------------------------------------------------------------
# Comma-separated list of frontend origins allowed to call the API.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Production only; defaults to CORS_ALLOWED_ORIGINS.
# CSRF_TRUSTED_ORIGINS=https://crm.example.com

# JWT ---------------------------------------------------------------------------
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=1
AUTH_THROTTLE_RATE=10/minute

# File uploads ------------------------------------------------------------------
MAX_IMAGE_UPLOAD_SIZE=2097152

# AWS S3 (company logos) --------------------------------------------------------
# False = store uploads on local disk (backend/media). True = private S3 bucket.
USE_S3=False
AWS_STORAGE_BUCKET_NAME=your-bucket-name
AWS_S3_REGION_NAME=ap-south-1
# Credentials of a least-privilege IAM user (see docs/aws/). Leave empty to use
# an attached IAM role / the default AWS credential chain instead.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_MEDIA_PREFIX=media
# Lifetime of presigned logo URLs, in seconds.
AWS_QUERYSTRING_EXPIRE=3600
